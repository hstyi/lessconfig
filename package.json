{
    "name": "lessconfig",
    "version": "0.0.1",
    "license": "Apache-2.0",
    "type": "module",
    "scripts": {
        "dev": "wrangler d1 migrations apply DB --local --config wrangler.jsonc && vite",
        "build": "tsc -b && vite build",
        "lint": "oxlint",
        "preview": "npm run build && vite preview",
        "deploy": "npm build && wrangler deploy && wrangler d1 migrations apply DB --remote --config wrangler.jsonc",
        "cf-typegen": "wrangler types",
        "test": "vitest run",
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "test:watch": "vitest",
        "test:ui": "npm build && playwright test",
        "test:ui:report": "playwright show-report",
        "typecheck": "tsc -b && tsc -p tests/worker/tsconfig.json --noEmit && tsc -p tests/e2e/tsconfig.json --noEmit"
    },
    "dependencies": {
        "@cloudflare/kumo": "^2.15.0",
        "@codemirror/commands": "^6.11.1",
        "@codemirror/lang-json": "^6.0.2",
        "@codemirror/lang-yaml": "^6.1.3",
        "@codemirror/language": "^6.13.1",
        "@codemirror/legacy-modes": "^6.5.5",
        "@codemirror/merge": "^6.12.3",
        "@codemirror/state": "^6.7.6",
        "@codemirror/view": "^6.43.15",
        "@lezer/highlight": "^1.2.5",
        "@phosphor-icons/core": "^2.1.1",
        "@phosphor-icons/react": "^2.1.10",
        "@tanstack/react-virtual": "^3.14.23",
        "date-fns": "^4.4.0",
        "hono": "^4.13.14",
        "i18next": "^26.5.11",
        "lodash-es": "^4.18.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-i18next": "^17.1.9",
        "react-router": "^8.5.0",
        "yaml": "^2.9.1",
        "zustand": "^5.0.16"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.65.0",
        "@cloudflare/vitest-plugin": "^1.4.7",
        "@playwright/test": "^1.64.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/lodash-es": "^4.17.12",
        "@types/node": "^26.6.5",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@vitejs/plugin-react": "^6.1.1",
        "oxfmt": "^0.74.0",
        "oxlint": "^1.89.0",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0.2",
        "vite": "^8.3.0",
        "vitest": "^4.1.0",
        "wrangler": "^4.152.0"
    }
}
