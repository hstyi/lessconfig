{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "lessconfig",
    "main": "worker/index.ts",
    "compatibility_date": "2026-10-19",
    "compatibility_flags": ["enable_request_signal"],
    "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
    "d1_databases": [{ "binding": "DB", "database_name": "lessconfig", "migrations_dir": "migrations" }],
    "kv_namespaces": [{ "binding": "SESSIONS" }],
    "durable_objects": {
        "bindings": [{ "name": "WATCH", "class_name": "WatchCoordinator" }],
    },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WatchCoordinator"] }],
    "triggers": { "crons": ["0 0 */3 * *"] },
    "ratelimits": [{ "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
    "observability": { "enabled": true, "traces": { "enabled": true } },
    "upload_source_maps": true,
}
